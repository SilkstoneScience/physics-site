  "laws": {
    "force-plate-jump": {
      "statement": "Standing still, F = mg. Pushing off (t₀ ≤ t ≤ t₀ + τ, s = (t − t₀)/τ): F = mg(1 − sᵖ) + A sin(πs), an empirical pulse shape (approved by the teacher on 8 October 2026) that starts at mg and falls to zero at take-off. Take-off speed from the impulse of the net force (A.2): mv = ∫(F − mg)dt = τ(2A/π − mg/(p + 1)). In flight F = 0 for 2v/g + δ (δ: extra flight time from landing with bent knees). Landing (s = (t − t_L)/τ_L): F = mg·s + B sin(πs), then F = mg",
      "inputs": {
        "m": "kg",
        "g": "m s^-2",
        "t": "s",
        "t0": "s",
        "tau": "s",
        "A": "N",
        "p": "",
        "dL": "s",
        "tauL": "s",
        "B": "N"
      },
      "output": "N",
      "f": "({ m, g, t, t0, tau, A, p, dL, tauL, B }) => {\n      const W = m * g;\n      if (t < t0) return W;\n      if (t <= t0 + tau) { const s = (t - t0) / tau; return W * (1 - s ** p) + A * Math.sin(Math.PI * s); }\n      const v = (tau * ((2 * A) / Math.PI - W / (p + 1))) / m;\n      const tL = t0 + tau + (2 * v) / g + dL;\n      if (t < tL) return 0;\n      if (t <= tL + tauL) { const s = (t - tL) / tauL; return W * s + B * Math.sin(Math.PI * s); }\n      return W;\n    }"
    }
  },
